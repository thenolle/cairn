{
	"name": "cairn",
	"version": "0.0.0",
	"private": true,
	"description": "A local-first gaming ecosystem: library, launchers, emulators, saves and optional encrypted sync.",
	"license": "PolyForm-Strict-1.0.0",
	"type": "module",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"generate": "bun scripts/generate.ts",
		"dev": "bun scripts/dev.ts",
		"build": "bun scripts/build.ts",
		"start": "bun dist/server/index.js",
		"open": "bun src/server/cli/open.ts",
		"database": "bun src/server/cli/database.ts",
		"typecheck": "tsc --noEmit",
		"check": "bun run generate && bun run typecheck && bun scripts/check-repo.ts && bun run build"
	},
	"dependencies": {
		"@gambrel/browser": "0.2.3",
		"@gambrel/bun": "0.2.3",
		"@gambrel/compiler": "0.2.3",
		"@gambrel/components": "0.2.3",
		"@gambrel/core": "0.2.3",
		"@gambrel/icons": "0.2.3",
		"@gambrel/router": "0.2.3",
		"@gambrel/ssr": "0.2.3",
		"@gambrel/view": "0.2.3"
	},
	"devDependencies": {
		"@types/bun": "1.4.5",
		"typescript": "7.0.2"
	}
}
