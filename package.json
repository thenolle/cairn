{
	"name": "cairn",
	"version": "0.0.0",
	"private": true,
	"description": "A local-first gaming ecosystem: library, launchers, emulators, saves and optional encrypted sync.",
	"license": "PolyForm-Strict-1.0.0",
	"type": "module",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"start": "bun src/server/index.ts",
		"dev": "bun --watch src/server/index.ts",
		"open": "bun src/server/cli/open.ts",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun scripts/check-repo.ts"
	},
	"dependencies": {
		"@gambrel/browser": "0.2.3",
		"@gambrel/bun": "0.2.3",
		"@gambrel/compiler": "0.2.3",
		"@gambrel/components": "0.2.3",
		"@gambrel/core": "0.2.3",
		"@gambrel/icons": "0.2.3",
		"@gambrel/router": "0.2.3",
		"@gambrel/ssr": "0.2.3",
		"@gambrel/view": "0.2.3"
	},
	"devDependencies": {
		"@types/bun": "1.4.5",
		"typescript": "7.0.2"
	}
}
